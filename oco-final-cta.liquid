{%- comment -%}
  OCO 9/9 — Final CTA with a real pack selector (matches the Lovable design).
  Builds one card per product variant from product.variants (label, price, MRP
  strikethrough, per-tube, "you save", BEST VALUE badge on the cheapest-per-tube
  card). Add to Cart / Buy Now use /cart/add.js so the main product form and
  GoKwik flow are never touched.

  Per-tube needs the pack size in the variant title (e.g. "Pack of 3" -> 3).
  Headings come from oco.final_title/_subtitle/_eyebrow metafields or settings.
{%- endcomment -%}
{%- liquid
  assign eyebrow  = product.metafields.oco.final_eyebrow.value | default: section.settings.eyebrow
  assign title    = product.metafields.oco.final_title.value | default: section.settings.title
  assign subtitle = product.metafields.oco.final_subtitle.value | default: section.settings.subtitle
  assign current  = product.selected_or_first_available_variant

  assign best_id = 0
  assign best_per = 9999999999
  for v in product.variants
    assign tubes = v.title | split: ' ' | last | plus: 0
    if tubes > 0
      assign per = v.price | divided_by: tubes
      if per < best_per
        assign best_per = per
        assign best_id = v.id
      endif
    endif
  endfor
-%}
{%- style -%}
  #oco-cta-{{ section.id }} { --p:{{ section.settings.color_primary }}; --pf:#fcfcfc; --pd:#005b4d; --fg:#061415; --bd:#dde7e7;
    background:var(--fg); color:#fff; }
  #oco-cta-{{ section.id }} .w { max-width:1100px; margin-inline:auto; padding:clamp(3rem,8vw,6rem) 1rem; text-align:center; }
  @media(min-width:640px){ #oco-cta-{{ section.id }} .w{ padding-inline:1.5rem; } }
  #oco-cta-{{ section.id }} .ey { display:inline-flex; align-items:center; gap:.4rem; padding:.4rem .8rem; border-radius:999px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2); color:#fff; font-size:.78rem; font-weight:600; }
  #oco-cta-{{ section.id }} .ey svg { width:1rem; height:1rem; }
  #oco-cta-{{ section.id }} h2 { font-size:clamp(1.7rem,4vw,2.25rem); font-weight:800; letter-spacing:-.02em; margin:.75rem 0 0; line-height:1.15; }
  #oco-cta-{{ section.id }} .sub { margin:.75rem auto 0; max-width:42rem; color:rgba(255,255,255,.7); }

  #oco-cta-{{ section.id }} .packs { display:grid; gap:1rem; max-width:46rem; margin:2.5rem auto 0; }
  @media(min-width:640px){ #oco-cta-{{ section.id }} .packs{ grid-template-columns:repeat(2,1fr); } }
  #oco-cta-{{ section.id }} .pack {
    position:relative; text-align:left; cursor:pointer; border-radius:1.4rem; padding:1.5rem;
    background:rgba(255,255,255,.05); border:2px solid rgba(255,255,255,.15); color:#fff;
    transition:border-color .15s ease, background .15s ease; font:inherit; width:100%;
  }
  #oco-cta-{{ section.id }} .pack:hover { border-color:rgba(255,255,255,.4); }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] { background:#fff; color:var(--fg); border-color:var(--p); }
  #oco-cta-{{ section.id }} .pack[disabled] { opacity:.45; cursor:not-allowed; }
  #oco-cta-{{ section.id }} .pack__label { font-size:.9rem; font-weight:600; color:rgba(255,255,255,.7); }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] .pack__label { color:var(--pd); }
  #oco-cta-{{ section.id }} .pack__price { margin-top:.5rem; display:flex; align-items:flex-end; gap:.5rem; }
  #oco-cta-{{ section.id }} .pack__now { font-size:1.85rem; font-weight:800; line-height:1; }
  #oco-cta-{{ section.id }} .pack__mrp { font-size:.85rem; padding-bottom:2px; text-decoration:line-through; color:rgba(255,255,255,.5); }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] .pack__mrp { color:#9aa6a4; }
  #oco-cta-{{ section.id }} .pack__meta { font-size:.78rem; margin-top:.35rem; font-weight:600; color:rgba(255,255,255,.7); }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] .pack__meta { color:var(--pd); }
  #oco-cta-{{ section.id }} .pack__state { margin-top:1rem; display:inline-block; font-size:.78rem; font-weight:700; color:rgba(255,255,255,.8); }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] .pack__state { color:var(--pd); }
  #oco-cta-{{ section.id }} .pack__state .sel { display:none; }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] .pack__state .sel { display:inline; }
  #oco-cta-{{ section.id }} .pack[aria-pressed="true"] .pack__state .unsel { display:none; }
  #oco-cta-{{ section.id }} .pack__badge {
    position:absolute; top:-12px; left:50%; transform:translateX(-50%); white-space:nowrap;
    font-size:10px; font-weight:700; letter-spacing:.04em; padding:4px 12px; border-radius:999px;
    background:var(--p); color:var(--pf);
  }

  #oco-cta-{{ section.id }} .btns { display:grid; gap:.75rem; max-width:42rem; margin:2rem auto 0; }
  @media(min-width:640px){ #oco-cta-{{ section.id }} .btns{ grid-template-columns:1fr 1fr; } }
  #oco-cta-{{ section.id }} .btn { display:inline-flex; align-items:center; justify-content:center; gap:.5rem; width:100%; font-weight:700; padding:.95rem 1.25rem; border-radius:999px; border:0; cursor:pointer; text-decoration:none; font-size:1rem; transition:transform .15s ease, background .15s ease, opacity .15s ease; }
  #oco-cta-{{ section.id }} .btn svg { width:1.25rem; height:1.25rem; }
  #oco-cta-{{ section.id }} .btn--add { background:var(--p); color:var(--pf); box-shadow:0 10px 24px -8px color-mix(in oklab, var(--p) 55%, transparent); }
  #oco-cta-{{ section.id }} .btn--add:hover { background:var(--pd); transform:translateY(-1px); }
  #oco-cta-{{ section.id }} .btn--buy { background:#fff; color:var(--fg); }
  #oco-cta-{{ section.id }} .btn--buy:hover { opacity:.9; }
  #oco-cta-{{ section.id }} .btn[disabled] { opacity:.5; cursor:not-allowed; }

  #oco-cta-{{ section.id }} .trust { margin-top:1.5rem; display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:.5rem 1.5rem; font-size:.75rem; color:rgba(255,255,255,.7); }
  #oco-cta-{{ section.id }} .trust span { display:inline-flex; align-items:center; gap:.4rem; }
  #oco-cta-{{ section.id }} .trust svg { width:.95rem; height:.95rem; }
{%- endstyle -%}

<div id="oco-cta-{{ section.id }}" data-cta>
  <div class="w">
    {%- if eyebrow != blank -%}
      <span class="ey"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s5 4 5 9a5 5 0 1 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-4 1-6 1-8z"/></svg>{{ eyebrow }}</span>
    {%- endif -%}
    <h2>{{ title }}</h2>
    {%- if subtitle != blank -%}<p class="sub">{{ subtitle }}</p>{%- endif -%}

    {%- if product.variants.size > 0 -%}
      <div class="packs" role="group" aria-label="Choose your pack">
        {%- for v in product.variants -%}
          {%- liquid
            assign tubes = v.title | split: ' ' | last | plus: 0
            assign on_sale = false
            if v.compare_at_price > v.price
              assign on_sale = true
              assign save_amt = v.compare_at_price | minus: v.price
              assign save_pct = save_amt | times: 100 | divided_by: v.compare_at_price
            endif
            assign is_sel = false
            if v.id == current.id
              assign is_sel = true
            endif
          -%}
          <button type="button" class="pack" data-pack
            data-id="{{ v.id }}"
            data-price="{{ v.price }}"
            data-price-f="{{ v.price | money }}"
            aria-pressed="{% if is_sel %}true{% else %}false{% endif %}"
            {% unless v.available %}disabled aria-disabled="true"{% endunless %}>
            {%- if v.id == best_id and on_sale -%}<span class="pack__badge">BEST VALUE · SAVE {{ save_pct }}%</span>
            {%- elsif v.id == best_id -%}<span class="pack__badge">BEST VALUE</span>{%- endif -%}
            <span class="pack__label">{{ v.title }}</span>
            <span class="pack__price">
              <span class="pack__now">{{ v.price | money }}</span>
              {%- if on_sale -%}<span class="pack__mrp">{{ v.compare_at_price | money }}</span>{%- endif -%}
            </span>
            <span class="pack__meta">
              {%- if tubes > 0 -%}{{ cart.currency.symbol }}{{ v.price | divided_by: tubes | divided_by: 100 | round }}/tube{%- endif -%}
              {%- if on_sale -%}{% if tubes > 0 %} · {% endif %}You save {{ save_amt | money }}{%- endif -%}
            </span>
            <span class="pack__state"><span class="unsel">Select pack →</span><span class="sel">Selected →</span></span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="btns">
      <button type="button" class="btn btn--add" data-add {% unless current.available %}disabled{% endunless %}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11.2A2 2 0 0 0 9.4 17h8.2a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        <span data-add-label>{{ section.settings.button_label }} — {{ current.price | money }}</span>
      </button>
      <button type="button" class="btn btn--buy" data-buy {% unless current.available %}disabled{% endunless %}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>
        Buy Now
      </button>
    </div>

    <div class="trust">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Secure payments</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>Pan-India free delivery</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>Easy returns</span>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('oco-cta-{{ section.id }}');
    if (!root) return;
    var packs = Array.prototype.slice.call(root.querySelectorAll('[data-pack]'));
    var addBtn = root.querySelector('[data-add]');
    var buyBtn = root.querySelector('[data-buy]');
    var addLabel = root.querySelector('[data-add-label]');
    var addText = {{ section.settings.button_label | json }};
    var selected = root.querySelector('[data-pack][aria-pressed="true"]') || packs[0] || null;

    function select(btn) {
      if (!btn || btn.hasAttribute('disabled')) return;
      selected = btn;
      packs.forEach(function (p) { p.setAttribute('aria-pressed', p === btn ? 'true' : 'false'); });
      if (addLabel) addLabel.textContent = addText + ' — ' + btn.getAttribute('data-price-f');
    }
    packs.forEach(function (p) { p.addEventListener('click', function () { select(p); }); });

    function addToCart() {
      if (!selected) return Promise.reject();
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: selected.getAttribute('data-id'), quantity: 1 })
      });
    }

    function openDrawerOrCart() {
      var drawer = document.querySelector('cart-drawer');
      fetch('/?sections=cart-drawer,cart-icon-bubble').then(function (r) { return r.json(); }).then(function (s) {
        try {
          if (drawer && s['cart-drawer']) {
            var tmp = document.createElement('div'); tmp.innerHTML = s['cart-drawer'];
            var nd = tmp.querySelector('cart-drawer'); if (nd) drawer.innerHTML = nd.innerHTML;
          }
          var bubble = document.querySelector('#cart-icon-bubble');
          if (bubble && s['cart-icon-bubble']) {
            var t2 = document.createElement('div'); t2.innerHTML = s['cart-icon-bubble'];
            var nb = t2.querySelector('#cart-icon-bubble'); if (nb) bubble.innerHTML = nb.innerHTML;
          }
        } catch (e) {}
        if (drawer && typeof drawer.open === 'function') drawer.open();
        else window.location.href = '/cart';
      }).catch(function () { window.location.href = '/cart'; });
    }

    if (addBtn) addBtn.addEventListener('click', function () {
      addBtn.disabled = true;
      addToCart().then(function (r) {
        if (!r || !r.ok) throw new Error('add failed');
        openDrawerOrCart();
      }).catch(function () { alert('Unable to add to cart. Please try again.'); })
        .finally(function () { addBtn.disabled = false; });
    });

    // Buy Now -> add then go to cart so the store's normal (GoKwik) checkout flow
    // takes over. If you do NOT use GoKwik, change '/cart' to '/checkout'.
    if (buyBtn) buyBtn.addEventListener('click', function () {
      buyBtn.disabled = true;
      addToCart().then(function (r) {
        if (!r || !r.ok) throw new Error('add failed');
        window.location.href = '/cart';
      }).catch(function () { alert('Unable to proceed. Please try again.'); buyBtn.disabled = false; });
    });
  })();
</script>

{% schema %}
{
  "name": "OCO 9 · Final CTA",
  "tag": "section",
  "class": "oco-section",
  "settings": [
    { "type": "paragraph", "content": "Real pack selector built from this product's variants + working Add to Cart / Buy Now. Per-product text overrides: oco.final_title/_subtitle/_eyebrow." },
    { "type": "color", "id": "color_primary", "label": "Accent / button colour", "default": "#288674" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited-time pricing" },
    { "type": "text", "id": "title", "label": "Title", "default": "Choose Your Pack" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Stock up and save — Pack of 5 is our best value." },
    { "type": "text", "id": "button_label", "label": "Add-to-cart label", "default": "Add to Cart" }
  ],
  "presets": [ { "name": "OCO 9 · Final CTA" } ]
}
{% endschema %}
